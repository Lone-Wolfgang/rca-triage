# env.example — copy to .env and fill in, then run: python gen-config.py
#
# The dashboard is a static local page, so it can't read these at runtime.
# `gen-config.py` reads them from your environment and writes config.js.
#
# Load them into your shell however you like, e.g.:
#     export $(grep -v '^#' .env | xargs)      # or use direnv / dotenv
#     python gen-config.py
#
# .env and config.js are gitignored — never commit a real key.

# ---- Model connection (LiteLLM gateway, OpenAI-compatible) -----------------
# Model NAME, used verbatim as the `model` field (same as the eval harness):
#   databricks-claude-sonnet-4, databricks-claude-haiku-4-5, etc.
LITELLM_MODEL=

# Gateway base URL — the OpenAI-compatible root the browser POSTs to.
# The dashboard calls  <BASE_URL>/chat/completions.
#   e.g. https://<gateway-host>/v1
LITELLM_BASE_URL=

# Gateway key.
LITELLM_KEY=

# ---- Optional dashboard defaults -------------------------------------------
# Defaults for the two 0..10 dials when a class isn't given explicitly.
# (Per-class overrides can be edited directly in config.js after generation.)
RCA_SEVERITY_DEFAULT=5
RCA_BLEND_DEFAULT=5
